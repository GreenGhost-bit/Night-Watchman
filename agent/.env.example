# ============================================================================
# agent/.env.example — local copy for the agent/ workstream only.
# Mirrors the relevant var names from the root .env.example so this module
# drops in with zero renaming once the real root .env is filled in. Copy to
# agent/.env for local runs; agent/.env is gitignored.
# ============================================================================

# --- Graph mode switch -------------------------------------------------------
# "fixture" (default if unset) reads committed JSON fixtures under
# src/graph/fixtures/ - no account or API key needed, fully offline/testable.
# "live" queries the real Graph gateway and requires THE_GRAPH_API_KEY below.
GRAPH_MODE=fixture

# --- The Graph ---------------------------------------------------------------
# [ACCOUNT — YOU FILL THIS IN] free signup at https://thegraph.com/studio/apikeys/
# Only required when GRAPH_MODE=live.
THE_GRAPH_API_KEY=

# Real, confirmed-live Messari-standardized lending subgraph IDs on The
# Graph's decentralized network (verified against messari/subgraphs
# deployment/deployment.json, schema version 3.1.0, status "prod" - see
# src/graph/SUBGRAPH_NOTES.md for the full research trail and how to
# re-verify once THE_GRAPH_API_KEY is live).
GRAPH_AAVE_V3_SUBGRAPH_ID=JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk
GRAPH_COMPOUND_V3_SUBGRAPH_ID=AwoxEZbiWLvv6e3QdvdMZw4WDURdGbvPfHmZRc8Dpfz9
GRAPH_SPARK_SUBGRAPH_ID=GbKdmBe4ycCYCQLQSjqGg6UHYoYfbyJyq5WrG35pv1si

# Morpho Blue: left BLANK on purpose. Messari's own Morpho Blue subgraph is
# "status": "dev" in their deployment.json (never published to the
# decentralized network), and the Morpho-maintained alternative
# (morpho-org/morpho-blue-subgraph) is officially deprecated/unmaintained as
# of March 2025 per docs.morpho.org. See SUBGRAPH_NOTES.md. If a live,
# indexed, Messari-schema Morpho subgraph ID is confirmed later, set it here
# and it is picked up automatically with zero code changes.
GRAPH_MORPHO_SUBGRAPH_ID=

# Substitute for Morpho Blue in the composability demo (see
# SUBGRAPH_NOTES.md for why): Seamless Protocol on Base, a real, separately
# operated lending protocol on the same Messari lending schema 3.1.0.
GRAPH_SEAMLESS_SUBGRAPH_ID=2u4mWUV4xS19ef1MbnxZHWLLMwdPxtVifH46JbonXwXP

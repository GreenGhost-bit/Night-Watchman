# agent/ local overrides. Copy to agent/.env (gitignored).
# Mirrors the root .env.example names so it drops in without renaming.

# "fixture" reads committed JSON under src/graph/fixtures/ — fully offline,
# no key needed. "live" queries the real gateway and needs the key below.
GRAPH_MODE=fixture
THE_GRAPH_API_KEY=            # [ACCOUNT] https://thegraph.com/studio/apikeys/

# Messari-standardized lending subgraphs, schema 3.1.0. See SUBGRAPH_NOTES.md
# for the verification trail on each.
GRAPH_AAVE_V3_SUBGRAPH_ID=JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk
GRAPH_COMPOUND_V3_SUBGRAPH_ID=AwoxEZbiWLvv6e3QdvdMZw4WDURdGbvPfHmZRc8Dpfz9
GRAPH_SPARK_SUBGRAPH_ID=GbKdmBe4ycCYCQLQSjqGg6UHYoYfbyJyq5WrG35pv1si

# Seamless (Base) stands in for Morpho Blue, whose Messari subgraph was never
# published to the decentralized network. Both are optional — the watchtower
# reports any unreachable source as degraded and keeps serving the rest.
GRAPH_SEAMLESS_SUBGRAPH_ID=2u4mWUV4xS19ef1MbnxZHWLLMwdPxtVifH46JbonXwXP
GRAPH_MORPHO_SUBGRAPH_ID=

# The Night Watchman — environment template. Copy to .env and fill in.
# .env is gitignored. [ACCOUNT] marks values that need your own signup.

# --- Arc testnet (Circle) ---------------------------------------------------
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000  # native USDC, 6 decimals
ARC_BLOCK_EXPLORER=https://testnet.arcscan.app

# [ACCOUNT] Deployer funded from https://faucet.circle.com. On Arc, USDC is the
# gas token, so one faucet drip covers both gas and pool liquidity.
# The default below is anvil's well-known test key — local use only, zero value.
ARC_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Sepolia (Chainlink Liquidation Protection Challenge) -------------------
SEPOLIA_RPC_URL=              # [ACCOUNT] https://sepolia.infura.io/v3/<key>
SEPOLIA_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ETHERSCAN_API_KEY=            # [ACCOUNT] optional, for --verify
CHAINLINK_CHALLENGE_CONTRACT= # [ACCOUNT] from the Chainlink prize page

# --- The Graph --------------------------------------------------------------
THE_GRAPH_API_KEY=            # [ACCOUNT] https://thegraph.com/studio/apikeys/
GRAPH_MODE=fixture            # "fixture" = offline demo data. "live" once the key is set.

# Messari-standardized lending subgraphs. See agent/src/graph/SUBGRAPH_NOTES.md
# for how each ID was verified and why Morpho Blue has no usable deployment.
GRAPH_AAVE_V3_SUBGRAPH_ID=JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk
GRAPH_COMPOUND_V3_SUBGRAPH_ID=AwoxEZbiWLvv6e3QdvdMZw4WDURdGbvPfHmZRc8Dpfz9
GRAPH_SPARK_SUBGRAPH_ID=GbKdmBe4ycCYCQLQSjqGg6UHYoYfbyJyq5WrG35pv1si
GRAPH_SEAMLESS_SUBGRAPH_ID=2u4mWUV4xS19ef1MbnxZHWLLMwdPxtVifH46JbonXwXP
GRAPH_MORPHO_SUBGRAPH_ID=     # no live Messari-schema deployment; see SUBGRAPH_NOTES.md

# --- Chainlink CRE ----------------------------------------------------------
CRE_API_KEY=                  # [ACCOUNT] from `cre login`
CRE_WORKFLOW_OWNER_ADDRESS=

# --- Agent ------------------------------------------------------------------
AGENT_NETWORK=local           # local (anvil) | arc | sepolia
# Anvil account #1 — deliberately different from the demo user (#0) so the
# vault's per-user authorization boundary is exercised even in local dev.
AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
DEMO_USER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
WATCHLIST=                    # comma-separated addresses; blank = fixture demo set

# Filled in from the deploy script's printed output.
WATCHMAN_VAULT_ADDRESS=
MOCK_LENDING_POOL_ADDRESS=
MOCK_LENDING_POOL_ADAPTER_ADDRESS=
MOCK_PRICE_FEED_ADDRESS=
MOCK_WETH_ADDRESS=
USDC_ADDRESS=

AGENT_POLL_INTERVAL_MS=15000
AGENT_API_PORT=4000

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_WATCHMAN_VAULT_ADDRESS=
NEXT_PUBLIC_MOCK_LENDING_POOL_ADDRESS=
NEXT_PUBLIC_AGENT_API_URL=http://localhost:4000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=  # [ACCOUNT] free at https://cloud.reown.com

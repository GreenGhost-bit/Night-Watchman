# ============================================================================
# THE NIGHT WATCHMAN — environment variables
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#
# Items marked [ACCOUNT — YOU FILL THIS IN] require a signup/credential that
# only you can create. Claude will not create these accounts or generate
# these keys. Items marked [LOCAL / SAFE DEFAULT] are fine to leave as-is
# for local development (anvil's well-known test keys, public RPC URLs).
# ============================================================================

# --- Arc testnet (Circle) ---------------------------------------------------
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network          # public, no key needed
ARC_TESTNET_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000  # native USDC on Arc, 6-decimal ERC20 view
ARC_BLOCK_EXPLORER=https://testnet.arcscan.app

# [ACCOUNT — YOU FILL THIS IN] Deployer key funded with testnet USDC from https://faucet.circle.com
# For LOCAL anvil testing only, use anvil's well-known default key (safe, public, zero real value):
ARC_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Sepolia (Chainlink Automated Liquidation Protection Challenge) --------
SEPOLIA_RPC_URL=                                              # [ACCOUNT — YOU FILL THIS IN] e.g. Alchemy/Infura free tier
SEPOLIA_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ETHERSCAN_API_KEY=                                            # [ACCOUNT — YOU FILL THIS IN] optional, for verify
CHAINLINK_CHALLENGE_CONTRACT=                                 # [ACCOUNT — YOU FILL THIS IN] from Chainlink prize page, fill before join()

# --- The Graph ---------------------------------------------------------------
# [ACCOUNT — YOU FILL THIS IN] free signup at https://thegraph.com/studio/apikeys/
THE_GRAPH_API_KEY=
GRAPH_MODE=fixture                                            # "fixture" = offline demo data, no key needed. "live" once THE_GRAPH_API_KEY is set.
# Gateway query URL pattern: https://gateway.thegraph.com/api/{THE_GRAPH_API_KEY}/subgraphs/id/{SUBGRAPH_ID}
# Confirmed live, schema 3.1.0, "prod" status — see agent/src/graph/SUBGRAPH_NOTES.md for the research trail.
GRAPH_AAVE_V3_SUBGRAPH_ID=JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk
GRAPH_COMPOUND_V3_SUBGRAPH_ID=AwoxEZbiWLvv6e3QdvdMZw4WDURdGbvPfHmZRc8Dpfz9
GRAPH_SPARK_SUBGRAPH_ID=GbKdmBe4ycCYCQLQSjqGg6UHYoYfbyJyq5WrG35pv1si
GRAPH_MORPHO_SUBGRAPH_ID=                                     # left blank: Morpho's own subgraph is dev-status/unmaintained, see SUBGRAPH_NOTES.md
GRAPH_SEAMLESS_SUBGRAPH_ID=2u4mWUV4xS19ef1MbnxZHWLLMwdPxtVifH46JbonXwXP  # substitutes for Morpho Blue in the composability demo

# --- Chainlink CRE -------------------------------------------------------------
# [ACCOUNT — YOU FILL THIS IN] from the CRE CLI login flow (cre login) — not created by Claude
CRE_API_KEY=
CRE_WORKFLOW_OWNER_ADDRESS=

# --- Agent (TypeScript orchestrator) -------------------------------------------
AGENT_NETWORK=local                                           # local (anvil) | arc | sepolia
# [LOCAL / SAFE DEFAULT] Anvil's well-known account #1 — deliberately different from the
# deployer/demo-user (account #0) so WatchmanVault's per-user authorizeAgent boundary is
# meaningful even in local dev. Swap to your own funded key before deploying for real.
AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
DEMO_USER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266    # Anvil account #0 — the demo position's owner
WATCHLIST=                                                     # comma-separated real addresses for the Watchtower once GRAPH_MODE=live; blank = use the fixture demo addresses

# Filled in from the deploy script's printed output (contracts/script/DeployArc.s.sol or
# DeploySepolia.s.sol) — copy its console.log lines straight in below.
WATCHMAN_VAULT_ADDRESS=
MOCK_LENDING_POOL_ADDRESS=
MOCK_LENDING_POOL_ADAPTER_ADDRESS=
MOCK_PRICE_FEED_ADDRESS=
MOCK_WETH_ADDRESS=
USDC_ADDRESS=                                                  # ARC_USDC_ADDRESS on Arc, or the deployed MockUSDC/SEPOLIA_USDC_ADDRESS on Sepolia

AGENT_POLL_INTERVAL_MS=15000
AGENT_API_PORT=4000

# --- Frontend -------------------------------------------------------------------
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_WATCHMAN_VAULT_ADDRESS=
NEXT_PUBLIC_MOCK_LENDING_POOL_ADDRESS=
NEXT_PUBLIC_AGENT_API_URL=http://localhost:4000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=                         # [ACCOUNT — YOU FILL THIS IN] free at https://cloud.reown.com

# --- ENS (stretch) ---------------------------------------------------------------
ENS_SEPOLIA_PARENT_NAME=                                      # [ACCOUNT — YOU FILL THIS IN] an ENSv2 name you control on Sepolia
ENS_AGENT_SUBNAME=watchman

# --- Bazantic (stretch) -----------------------------------------------------------
BAZANTIC_USERNAME=                                            # [ACCOUNT — YOU FILL THIS IN]
BAZANTIC_API_KEY=

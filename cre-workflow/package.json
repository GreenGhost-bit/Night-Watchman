{
  "name": "night-watchman-cre-workflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workflow": "bun test workflow.test.ts",
    "typecheck": "tsc --noEmit",
    "simulate:staging": "../tools/cre/cre.exe workflow simulate . --target staging-settings --non-interactive --http-payload '{\"riskRatio\": 0.9, \"debtUSD\": 10000}'",
    "simulate:production": "../tools/cre/cre.exe workflow simulate . --target production-settings --non-interactive --http-payload '{\"riskRatio\": 0.9, \"debtUSD\": 10000}'"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@chainlink/cre-sdk": "1.18.0",
    "viem": "2.34.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun": "1.4.2",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  }
}

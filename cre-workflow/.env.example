### cre-workflow local environment ###########################################
# Copy to .env in this directory. .env is gitignored -- never commit it.
#
# Everything below is [LOCAL / SAFE DEFAULT]: demo policy numbers, not real
# credentials. Nothing here needs a Chainlink CRE account to set.
###############################################################################

# Optional for `cre workflow simulate`; only required by `cre workflow deploy`
# (a manual, user-run step -- see README.md). 64-char hex, no 0x prefix.
CRE_ETH_PRIVATE_KEY=

# --- The Night Watchman's private liquidation-defense policy ----------------
# These three map (via secrets.yaml) to the secrets the TEE handler in
# workflow.ts reads with runtime.getSecrets() -- see README.md for why they
# must stay private. Demo defaults below: defend once the implied health
# factor drops to 1.20, cap any single defense at 5,000 USDC.
NIGHT_WATCHMAN_MIN_HEALTH_FACTOR_BPS=12000
NIGHT_WATCHMAN_MAX_DEFENSE_USDC=5000
NIGHT_WATCHMAN_EXECUTION_KEY_REF=demo-agent-wallet-key-ref

# --- Only needed once you actually deploy (see README "Manual steps") -------
# Matches the root .env.example's "Chainlink CRE" section.
# CRE_API_KEY=                    # [ACCOUNT] from `cre login`
# CRE_WORKFLOW_OWNER_ADDRESS=     # [ACCOUNT] your CRE workflow owner address
# SEPOLIA_RPC_URL=                # [ACCOUNT] referenced by project.yaml's ${SEPOLIA_RPC_URL}
